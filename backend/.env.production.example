# Production Environment Variables for Backend
# Copy this to .env and fill in your actual values

# Server Configuration
PORT=5000
NODE_ENV=production

# Database (MongoDB Atlas)
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/compliance_db?retryWrites=true&w=majority

# Authentication
JWT_SECRET=use_a_very_long_random_string_here_at_least_32_characters

# Email Configuration (Gmail)
MAIL_USER=your_production_email@gmail.com
MAIL_PASS=your_gmail_app_password_16_chars

# AI Services
HUGGINGFACE_API_KEY=hf_your_production_api_key_here

# Frontend URL (for CORS) - Update after deploying frontend
FRONTEND_URL=https://your-app.vercel.app

# Notes:
# - Generate JWT_SECRET: openssl rand -base64 32
# - Get Gmail App Password: https://myaccount.google.com/apppasswords
# - MongoDB Atlas: https://www.mongodb.com/cloud/atlas
# - HuggingFace API: https://huggingface.co/settings/tokens
