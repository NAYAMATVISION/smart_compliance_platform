# Production Environment Variables for Frontend
# Add this in Vercel Dashboard -> Settings -> Environment Variables

# Backend API URL (from Render deployment)
VITE_API_URL=https://your-backend-app.onrender.com

# Notes:
# - Do NOT include trailing slash
# - Update this after deploying backend to Render
# - In Vercel, add this as an environment variable
# - Redeploy frontend after adding/changing this variable
